# Nusxa oling: cp key.properties.example key.properties
# va o'z keystore ma'lumotlaringiz bilan to'ldiring.
#
# Keystore yaratish (bir marta, ILOVA UMRI DAVOMIDA BIR XIL QOLADI):
#   keytool -genkey -v -keystore upload-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# DIQQAT: bu faylni va .jks ni yo'qotsangiz, ilovaga yangilanish
# chiqara olmaysiz. Ikkalasini ham xavfsiz joyda zaxiralang.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=upload-keystore.jks
